{
  "name": "PlayWrightAutomation",
  "version": "1.0.0",
  "description": "Playwright + Cucumber BDD automation framework with AI agents for playwright.dev",
  "main": "index.js",
  "scripts": {
    "cucumber": "node --env-file=.env ./node_modules/@cucumber/cucumber/bin/cucumber-js",
    "cucumber:smoke": "node --env-file=.env ./node_modules/@cucumber/cucumber/bin/cucumber-js features/playwrightTests.feature --require-module ts-node/register --require 'features/**/*.ts' --tags @Smoke --exit",
    "cucumber:html": "node --env-file=.env ./node_modules/@cucumber/cucumber/bin/cucumber-js features/playwrightTests.feature --format html:cucumber-report.html --exit"
  },
  "keywords": ["playwright", "cucumber", "bdd", "typescript", "automation"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "*",
    "@playwright/test": "^1.56.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
